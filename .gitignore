# =============================================================================
# .gitignore - Mina-Translator
# =============================================================================

# Modèles (téléchargeables, pas besoin de push)
models/
*.safetensors
*.bin
*.pt
*.pth

# Environnements virtuels
venv/
venv_train/
.venv/
env/

# Cache Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Logs
*.log
logs/

# Fichiers temporaires
*.tmp
*.temp
.DS_Store

# Jupyter
.ipynb_checkpoints/

# Variables d'environnement
.env
.env.local

# Builds
dist/
build/
*.egg-info/

# Whisper data (regénérable)
data/whisper_data/

# Cache HuggingFace
.cache/