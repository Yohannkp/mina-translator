# =============================================================================
# CONFIGURATION MINA-TRANSLATOR B2B
# =============================================================================

# =============================================================================
# MASTER KEY - ACCÈS ADMIN ILLIMITÉ
# =============================================================================
# ⚠️ IMPORTANT: Ne JAMAIS commiter ce fichier sur GitHub!
# Copiez ce fichier en .env et ajoutez-le à .gitignore

# Générez votre Master Key avec:
# python -c "import secrets; print(secrets.token_urlsafe(48))"

# Exemple (REMPLACER par votre propre clé):
MINA_MASTER_KEY=mtk_master_votre_cle_secrete_ici_xyz789

# =============================================================================
# CONFIGURATION API
# =============================================================================

# Mode de l'API (development/production)
API_MODE=production

# Port de l'API
API_PORT=8000

# Host (0.0.0.0 pour accessible depuis le réseau)
API_HOST=0.0.0.0

# =============================================================================
# CONFIGURATION MODÈLE
# =============================================================================

# Chemin vers le modèle fine-tuné
MODEL_PATH=models/mina-translator

# Device (cuda/cpu)
DEVICE=cuda

# =============================================================================
# CONFIGURATION BASE DE DONNÉES
# =============================================================================

# Chemin vers la base SQLite
DATABASE_PATH=data/mina_api.db

# =============================================================================
# CONFIGURATION LOGGING
# =============================================================================

# Chemin vers le fichier de logs
LOG_PATH=logs/usage_stats.log

# Niveau de log (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO